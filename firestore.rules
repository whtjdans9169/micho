rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 관리자(MICHO) 계정의 고유 ID
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'JmFNoGhEQlW9MTrwkLOb6TCcGsg2';
    }

    // 실명: 본인은 자기 것만 쓰고 읽을 수 있고, 모두의 실명은 관리자만 읽을 수 있다
    match /realnames/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // 그 밖의 데이터: 로그인한 사람은 모두 읽고 쓸 수 있다 (프로필, 기록, 명언, 공지, 자료, 인증샷)
    match /{col}/{document=**} {
      allow read, write: if request.auth != null && col != 'realnames';
    }
  }
}
